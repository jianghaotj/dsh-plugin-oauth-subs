{
  "name": "dsh-plugin-oauth-subs",
  "version": "0.0.114",
  "description": "Maintained JavaScript artifact fork of dsh-plugin-oauth-subs: subscription OAuth for DeepSeek Harness; explicit pinned updates only.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jianghaotj/dsh-plugin-oauth-subs.git"
  },
  "bugs": {
    "url": "https://github.com/jianghaotj/dsh-plugin-oauth-subs/issues"
  },
  "homepage": "https://github.com/jianghaotj/dsh-plugin-oauth-subs#readme",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/ui/client.js",
    "./analyze-session": "./lib/utils/analyze-session.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh.md",
    "MAINTENANCE.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "node scripts/check-syntax.mjs",
    "test": "npm run check && node --test test/*.test.mjs",
    "test:pack": "node scripts/check-package.mjs",
    "audit:history": "node scripts/audit-history.mjs",
    "analyze": "node --experimental-strip-types scripts/analyze-session.ts",
    "prepublishOnly": "npm test && npm run test:pack && npm run audit:history"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "oauth",
    "chatgpt",
    "codex",
    "grok",
    "xai",
    "glm",
    "kiro",
    "pkce",
    "antigravity",
    "google",
    "cursor"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "undici": "^7.30.0"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
